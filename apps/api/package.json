{
  "name": "@veyra/api",
  "version": "0.0.0",
  "private": true,
  "description": "Veyra REST API: workflow, matching, resolution, validation, questions, commit.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "VEYRA_ALLOW_FIXTURE_EXTRACTOR=true tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:verify": "drizzle-kit generate --name drift | tee /dev/stderr | grep -q 'No schema changes'",
    "db:migrate": "tsx src/cli/migrate.ts",
    "fixtures": "tsx src/cli/generate-import-fixtures.ts",
    "db:migrate-from-sqlite": "tsx src/cli/migrate-from-sqlite.ts",
    "users": "tsx src/cli/users.ts",
    "bench": "tsx bench/run.ts",
    "bench:load": "tsx bench/load.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@veyra/erp-connector": "*",
    "@veyra/extractor": "*",
    "@veyra/fake-erp": "*",
    "@veyra/india-tax": "*",
    "@veyra/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
