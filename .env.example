# Veyra API configuration (Phase 6). Copy per environment and fill in; never commit real values.
# Everything is read from the environment at startup and validated (apps/api/src/config.ts). A
# missing or invalid value stops the API with a message naming the variable (never its value).
# Development needs none of this: `npm run demo` works out of the box.
#
# The web app has no configuration and no secrets: it is static files that call /api/v1 on the
# same origin. Anything given to the frontend build must be treated as public.

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production. NODE_ENV=production without VEYRA_ENV means production.
VEYRA_ENV=production
NODE_ENV=production

# ── Server ──────────────────────────────────────────────────────────────────
VEYRA_API_HOST=0.0.0.0
VEYRA_API_PORT=8787
# Reverse-proxy hops in front of the API (for the client address used by rate limits). 0 = none.
VEYRA_TRUST_PROXY=1
# fatal | error | warn | info | debug | silent  (default: info when deployed, warn in development)
VEYRA_LOG_LEVEL=info

# ── Data ────────────────────────────────────────────────────────────────────
# Absolute path on a PERSISTENT volume (not the container's ephemeral disk). Holds veyra.db and,
# until a real ERP connector exists, the fake ERP's fake_erp.db. One API instance per data dir.
VEYRA_DATA_DIR=/var/lib/veyra
# Apply database migrations at startup. Default: on in development/staging, OFF in production
# (run `npm run db:migrate -w @veyra/api` as a deployment step, after a backup).
# VEYRA_MIGRATE_ON_START=false

# ── Document storage ────────────────────────────────────────────────────────
# local: files under VEYRA_STORAGE_DIR (default <VEYRA_DATA_DIR>/uploads) on a persistent volume.
# s3: any S3-compatible bucket (AWS S3, DigitalOcean Spaces, MinIO, R2). The bucket must be private.
VEYRA_STORAGE=s3
# VEYRA_STORAGE_DIR=/var/lib/veyra/uploads
VEYRA_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
VEYRA_S3_REGION=eu-west-1
VEYRA_S3_BUCKET=veyra-documents-production
VEYRA_S3_ACCESS_KEY_ID=
VEYRA_S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted stores; false (virtual-hosted buckets) for AWS and Spaces.
VEYRA_S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, e.g. production/  (lowercase, ending in /)
VEYRA_S3_PREFIX=

# ── ERP ─────────────────────────────────────────────────────────────────────
# Only the fake ERP exists so far (the home-grown ERP connector is pending its API documentation).
# Required outside development so no deployment picks an ERP by accident.
VEYRA_ERP=fake

# ── Demo (never in production: refused at startup) ──────────────────────────
VEYRA_DEMO=false
VEYRA_ALLOW_FIXTURE_EXTRACTOR=false

# ── Optional local AI assist ────────────────────────────────────────────────
# VEYRA_OLLAMA_URL=http://127.0.0.1:11434
# VEYRA_OLLAMA_MODEL=llama3.1

# ── Limits (can only be lowered below the built-in maximums) ───────────────
# VEYRA_MAX_UPLOAD_BYTES=20971520        # ≤ 20 MB
# VEYRA_MAX_JSON_BODY_BYTES=1048576      # ≤ 10 MB
# VEYRA_MAX_PDF_PAGES=20                 # ≤ 20
# VEYRA_MAX_IMAGE_SIDE=12000             # ≤ 12000 px
# VEYRA_MAX_IMAGE_PIXELS=40000000        # ≤ 40 MP
# Requests per minute per client address:
# VEYRA_RATE_LIMIT_UPLOADS_PER_MINUTE=60
# VEYRA_RATE_LIMIT_PROCESSING_PER_MINUTE=120
# VEYRA_RATE_LIMIT_DEV_PER_MINUTE=60

# ── Jobs ────────────────────────────────────────────────────────────────────
# A running job not heard from for this long is treated as abandoned and re-queued (15 min).
# VEYRA_JOB_LEASE_MS=900000
# On SIGTERM: how long the current job may finish before it is put back in the queue (25 s).
# VEYRA_SHUTDOWN_GRACE_MS=25000
