# Veyra API configuration (Phase 6). Copy per environment and fill in; never commit real values.
# Everything is read from the environment at startup and validated (apps/api/src/config.ts). A
# missing or invalid value stops the API with a message naming the variable (never its value).
# Development needs none of this: `npm run demo` works out of the box. Every value here is a
# placeholder. Secrets (DATABASE_URL, DATABASE_MIGRATION_URL, VEYRA_DEMO_PIN, later ERP
# credentials) belong in the platform's secret store, never in Git (docs/SECURITY.md §11).
#
# The web app has no secrets: it is static files that call /api/v1 on the same origin. Its only
# build setting is VITE_API_BASE_URL (apps/web/.env.example); anything given to the frontend build
# is public, and the build refuses every other VITE_ variable.

# ── Environment ─────────────────────────────────────────────────────────────
# development | staging | production. NODE_ENV=production without VEYRA_ENV means production.
VEYRA_ENV=production
NODE_ENV=production

# ── Server ──────────────────────────────────────────────────────────────────
VEYRA_API_HOST=0.0.0.0
VEYRA_API_PORT=8787
# Platforms that assign a port set PORT; it is used when VEYRA_API_PORT is unset.
# PORT=8080
# Reverse-proxy hops in front of the API: used for the client address (rate limits) and to keep
# the proxy's x-request-id. 0 = none (client-supplied request ids are then ignored).
VEYRA_TRUST_PROXY=1
# fatal | error | warn | info | debug | silent  (default: info when deployed, warn in development)
VEYRA_LOG_LEVEL=info

# ── Database (Veyra application data: PostgreSQL) ──────────────────────────
# Required in staging and production. A secret: keep it in your secret store; never printed.
# Without it, development runs PostgreSQL embedded in the process (<VEYRA_DATA_DIR>/pgdata).
# Use the least-privilege runtime role (apps/api/sql/runtime-role.sql). A database on another host
# must use TLS in production (sslmode=verify-full or require), unless VEYRA_DB_REQUIRE_TLS=false.
DATABASE_URL=postgres://veyra_app:CHANGE_ME@db.example.internal:5432/veyra?sslmode=verify-full
# The schema owner, used only by `npm run db:migrate` (falls back to DATABASE_URL). Keep it out of
# the running API's environment where practical.
# DATABASE_MIGRATION_URL=postgres://veyra_owner:CHANGE_ME@db.example.internal:5432/veyra?sslmode=verify-full
# VEYRA_DB_REQUIRE_TLS=true
# Connections per API process (keep processes × pool below max_connections), timeouts.
# VEYRA_DB_POOL_MAX=10
# VEYRA_DB_CONNECT_TIMEOUT_MS=5000
# VEYRA_DB_STATEMENT_TIMEOUT_MS=30000

# ── Organization, sign-in and browser origins (docs/SECURITY.md) ───────────
# The one organization this deployment serves. Required in staging and production.
VEYRA_ORGANIZATION_NAME=Toit
# The exact https:// origin users open. State-changing requests from any other origin are refused.
# Required in staging and production (comma-separated if there are several).
VEYRA_PUBLIC_ORIGIN=https://veyra.example.com
# Other origins allowed to call the API with cookies (CORS). Normally unset: same origin. Never *.
# VEYRA_CORS_ORIGINS=https://other.example.com
# Session lifetimes: ended after this long without a request, and this long after sign-in.
# VEYRA_SESSION_IDLE_MINUTES=30
# VEYRA_SESSION_ABSOLUTE_HOURS=12
# Secure (HTTPS-only) session cookie. Default on outside development; cannot be off in production.
# VEYRA_COOKIE_SECURE=true
# Sign-in attempts per minute, per client address and per account.
# VEYRA_RATE_LIMIT_LOGIN_PER_MINUTE=10

# ── Data ────────────────────────────────────────────────────────────────────
# Absolute path on a PERSISTENT disk (not a container's ephemeral filesystem). Holds the uploaded
# documents and, until a real ERP connector exists, the fake ERP's fake_erp.db (SQLite).
VEYRA_DATA_DIR=/var/lib/veyra
# Apply database migrations at startup. Default: on in development/staging, OFF in production
# (run `npm run db:migrate -w @veyra/api` as a deployment step, after a backup).
# VEYRA_MIGRATE_ON_START=false

# ── Document storage ────────────────────────────────────────────────────────
# Local storage is the only document store today (object storage is a future adapter). Default:
# <VEYRA_DATA_DIR>/uploads. Must be on a persistent, backed-up disk (docs/DEPLOYMENT.md §8, §10).
# VEYRA_STORAGE_DIR=/var/lib/veyra/uploads

# ── ERP ─────────────────────────────────────────────────────────────────────
# Only the fake ERP exists so far (the home-grown ERP connector is pending its API documentation).
# Required outside development so no deployment picks an ERP by accident.
VEYRA_ERP=fake

# ── Demo (never in production: refused at startup) ──────────────────────────
VEYRA_DEMO=false
VEYRA_ALLOW_FIXTURE_EXTRACTOR=false
# Staging demos only: the PIN of the demo sign-in (4–12 digits; a secret). Development uses 8824.
# VEYRA_DEMO_PIN=CHANGE_ME

# ── Optional local AI assist ────────────────────────────────────────────────
# On this machine or a private network only. Document text is sent to it.
# VEYRA_OLLAMA_URL=http://127.0.0.1:11434
# VEYRA_OLLAMA_MODEL=llama3.1
# Sending document text to a non-local host needs this explicit opt-in (docs/SECURITY.md §12).
# VEYRA_OLLAMA_ALLOW_REMOTE=false

# ── Limits (can only be lowered below the built-in maximums) ───────────────
# VEYRA_MAX_UPLOAD_BYTES=20971520        # ≤ 20 MB
# VEYRA_MAX_JSON_BODY_BYTES=1048576      # ≤ 10 MB
# VEYRA_MAX_PDF_PAGES=20                 # ≤ 20
# VEYRA_MAX_IMAGE_SIDE=12000             # ≤ 12000 px
# VEYRA_MAX_IMAGE_PIXELS=40000000        # ≤ 40 MP
# Requests per minute per client address (per process, in memory: not a distributed limiter):
# VEYRA_RATE_LIMIT_UPLOADS_PER_MINUTE=60
# VEYRA_RATE_LIMIT_PROCESSING_PER_MINUTE=120
# VEYRA_RATE_LIMIT_DEV_PER_MINUTE=60

# ── Jobs ────────────────────────────────────────────────────────────────────
# A running job not heard from for this long is treated as abandoned and re-queued (5 min).
# VEYRA_JOB_LEASE_MS=300000
# On SIGTERM: how long the current job may finish before it is put back in the queue (25 s).
# VEYRA_SHUTDOWN_GRACE_MS=25000

# ── Public demo (docs/DEPLOYMENT.md §14) ────────────────────────────────────
# The hosted demo is a STAGING environment with the demo on; these override the values above.
# Every value is a placeholder: set the real ones in the API host's secret store, never in Git or
# in Vercel.
# VEYRA_ENV=staging
# VEYRA_DEMO=true
# VEYRA_DEMO_PIN=CHANGE_ME                       # 6–12 digits, a secret, shared out of band
# VEYRA_PUBLIC_ORIGIN=https://veyra-demo.vercel.app
# VEYRA_ORGANIZATION_NAME=Toit (demo)
# VEYRA_ALLOW_FIXTURE_EXTRACTOR=false
# VEYRA_MIGRATE_ON_START=false                   # migrations are a release step
# VEYRA_TRUST_PROXY=2                            # Vercel's edge + the host's router
# DATABASE_URL=postgres://veyra_app:CHANGE_ME@db.example.internal:5432/veyra_demo?sslmode=require
